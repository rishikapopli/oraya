# ORAYA backend — copy to .env and fill in. Never commit real secrets.

# Database. Local dev default (SQLite) works with no setup.
# Production (Supabase Postgres):
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./oraya.db

# Auth — generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=30

# Gemini (optional — app runs in demo mode without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Where generated files (mp4, exports) are written
STORAGE_DIR=./storage
